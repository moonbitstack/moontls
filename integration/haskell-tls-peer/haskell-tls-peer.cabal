cabal-version:      3.0
name:               haskell-tls-peer
version:            0.1.0
synopsis:           A peer for the moontls interop matrix, written against the tls package
build-type:         Simple

executable haskell-tls-peer
  main-is:          Main.hs
  hs-source-dirs:   src
  build-depends:    base >= 4.14
                  , bytestring
                  , tls >= 2.0
                  , network
                  , crypton-x509
                  , crypton-x509-store
                  , data-default-class
  default-language: Haskell2010
  ghc-options:      -O1 -threaded -rtsopts
