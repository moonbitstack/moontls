// TLS 1.3 extensions, RFC 8446 §4.2:
// https://www.rfc-editor.org/rfc/rfc8446#section-4.2
//
// The extension block's framing, the type registry, and the payload codec for
// each extension this library speaks: supported_versions (§4.2.1), which is
// what actually negotiates TLS 1.3; supported_groups (§4.2.7);
// signature_algorithms (§4.2.3); key_share (§4.2.8); and ALPN (RFC 7301 §3.1).
//
// quic_transport_parameters (RFC 9001 §8.2) has a type code here and no codec:
// the payload is QUIC's transport parameters (RFC 9000 §18), which `moonquic`
// defines. A TLS extension carries opaque octets, and reading somebody else's
// would be this package claiming to know them.
//
// What is negotiated from these — which group, which scheme, which version —
// is the handshake's decision and lives in `hs`, not here. This package only
// says what is on the wire.
import {
  "moonbitstack/moontls/wire",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitstack/moontls/ext",
  "moonbitstack/moonbase/base16",
} for "test"
