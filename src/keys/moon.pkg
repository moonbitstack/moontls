// TLS 1.3's key schedule, RFC 8446 §7.1:
// https://www.rfc-editor.org/rfc/rfc8446#section-7.1
//
// The transcript hash (§4.4.1) and a Finished message's verify_data (§4.4.4)
// are here too: they are what the schedule's secrets are consumed by, and a
// handshake keeps the accumulator beside the secrets.
//
// QUIC reuses this ladder unchanged (RFC 9001 §5.2), which is why the
// HKDF-Expand-Label framing sits in the protocol rather than in the KDF.
//
// The HKDF, the hashes and the MAC are `mooncrypt`'s. Not one line of
// cryptography is written here.
import {
  "moonbitstack/mooncrypt/kdf/hkdf",
  "moonbitstack/mooncrypt/hash/sha2",
  "moonbitstack/mooncrypt/mac/hmac",
  "moonbitstack/mooncrypt/spec",
}

import {
  "moonbitstack/moontls/keys",
  "moonbitstack/moonbase/base16",
} for "test"
