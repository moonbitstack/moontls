// The TLS 1.3 connection, RFC 8446: https://www.rfc-editor.org/rfc/rfc8446
//
// The record layer, key schedule, messages and negotiation joined into one connection, client
// or server, that takes ciphertext and gives back ciphertext and plaintext. No socket, no clock,
// no entropy of its own.
import {
  "moonbitstack/moontls/alert",
  "moonbitstack/moontls/ext",
  "moonbitstack/moontls/hs",
  "moonbitstack/moontls/keys",
  "moonbitstack/moontls/msg",
  "moonbitstack/moontls/record",
  "moonbitstack/moontls/wire",
  "moonbitstack/mooncrypt/asn1",
  "moonbitstack/mooncrypt/curve",
  "moonbitstack/mooncrypt/kex/ecdh",
  "moonbitstack/mooncrypt/kex/x25519",
  "moonbitstack/mooncrypt/kex/x448",
  "moonbitstack/mooncrypt/kex/dh",
  "moonbitstack/mooncrypt/pq/mlkem",
  "moonbitstack/mooncrypt/rsa",
  "moonbitstack/mooncrypt/sign/ecdsa",
  "moonbitstack/mooncrypt/hash/sha1",
  "moonbitstack/mooncrypt/hash/sha2",
  "moonbitstack/mooncrypt/spec",
  "moonbitstack/mooncred/x509",
  "moonbitstack/moonzip/zlib",
  "moonbitlang/core/cmp",
}

import {
  "moonbitstack/moontls/tls",
  "moonbitstack/moontls/alert",
  "moonbitstack/moontls/ext",
  "moonbitstack/moontls/msg",
  "moonbitstack/moontls/record",
  "moonbitstack/moontls/hs",
  "moonbitstack/moontls/keys",
  "moonbitstack/mooncrypt/kex/x25519",
  "moonbitstack/mooncrypt/rsa",
  "moonbitstack/mooncred/x509",
  "moonbitstack/mooncrypt/asn1",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonzip/zlib",
} for "test"
