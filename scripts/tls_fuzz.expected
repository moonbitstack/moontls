# What this library says about each of tlsfuzzer's TLS 1.3 scripts, one line per script.
#
# `scripts/tls_fuzz.sh` reads this after a run and judges it: a script recorded as `pass` that no
# longer passes is a regression and fails the job; a `gap` or a `hang` that starts passing is
# reported as an improvement and fails nothing. That is deliberate — a table that has to be edited
# before a fix can land would be edited wrongly, and the numbers in README.md are what the table
# says, so the two move together.
#
#   pass   the script passes in full
#   gap    the script runs and a conversation in it is answered wrongly
#   hang   the script does not finish inside `SCRIPT_TIMEOUT`
#   nosrv  the script needs a server this library cannot be configured with
#
# 55 of the 57 pass here, and the other 2 are the two README.md's "Conformance" section explains: one
# asks for a ticket RFC 8446 §4.2.9 says a server should not send, and the other needs a tool that
# can read the key it signs with.

0rtt-garbage                             pass
ccs                                      pass
certificate-compression                  pass
certificate-request                      pass
certificate-verify                       pass
client-certificate-compression           pass
connection-abort                         gap
conversation                             pass
count-tickets                            pass
crfg-curves                              pass
dhe-shared-secret-padding                pass
ecdhe-brainpool-curves                   pass
ecdhe-curves                             pass
ecdsa-brainpool-in-certificate-verify    gap
ecdsa-in-certificate-verify              pass
ecdsa-support                            pass
eddsa                                    pass
eddsa-in-certificate-verify              pass
empty-alert                              pass
ffdhe-groups                             pass
ffdhe-sanity                             pass
finished                                 pass
finished-plaintext                       pass
hrr                                      pass
invalid-ciphers                          pass
keyshare-omitted                         pass
keyupdate                                pass
keyupdate-from-server                    pass
large-number-of-extensions               pass
legacy-version                           pass
lengths                                  pass
minerva                                  pass
mldsa-in-certificate-verify              pass
mlkem                                    pass
multiple-ccs-messages                    pass
no-unknown-groups                        pass
nociphers                                pass
non-support                              pass
obsolete-curves                          pass
pkcs-signature                           pass
post-handshake-auth                      pass
psk_dhe_ke                               pass
psk_ke                                   pass
record-layer-limits                      pass
record-padding                           pass
rsa-signatures                           pass
rsapss-signatures                        pass
serverhello-random                       pass
session-resumption                       pass
shuffled-extentions                      pass
signature-algorithms                     pass
symetric-ciphers                         pass
unencrypted-alert                        pass
unrecognised-groups                      pass
version-negotiation                      pass
zero-content-type                        pass
zero-length-data                         pass
