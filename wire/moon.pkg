// The integer encodings and the frozen version octets every TLS 1.3 structure
// is written in, RFC 8446 §3 and §5.1:
// https://www.rfc-editor.org/rfc/rfc8446#section-3
//
// It exists because `record`, `ext` and `hs` all write the same big-endian
// widths and all carry the same `legacy_version`, and one concept should have
// one name. Zero dependencies, so needing it costs nothing.

import {
  "moonbitstack/moontls/wire",
} for "test"
